{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "github": {
    "autoJobCancelation": true
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fit.fssolucoes.tech"
        }
      ],
      "destination": "https://www.fsfit.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sistema-para-personal-trainer",
      "destination": "/sistema-para-personal-trainer.html"
    },
    {
      "source": "/lp-gads",
      "destination": "/sistema-para-personal-trainer.html"
    },
    {
      "source": "/p/:slug",
      "destination": "/personal.html?u=:slug"
    }
  ]
}
