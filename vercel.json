{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "github": {
    "autoJobCancelation": true
  },
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/personal.html?u=:slug"
    }
  ]
}
